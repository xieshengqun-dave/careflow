{
  "name": "careflow",
  "version": "0.1.0",
  "private": true,
  "description": "CareFlow - Smart Appointment & Queue Management Platform for Malaysian Clinics",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:web": "turbo run dev --filter=clinic-web",
    "dev:mobile": "turbo run dev --filter=patient-mobile",
    "db:generate": "turbo run db:generate --filter=@careflow/database",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react-dom>react": "18 || 19",
        "react-helmet-async>react-dom": ">=16"
      }
    }
  }
}
