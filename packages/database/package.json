{
  "name": "@careflow/database",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase client, generated types, and typed query builders",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./queries/clinics": "./src/queries/clinics.ts",
    "./queries/appointments": "./src/queries/appointments.ts",
    "./queries/queues": "./src/queries/queues.ts",
    "./queries/doctors": "./src/queries/doctors.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "db:generate": "supabase gen types typescript --local > src/types/supabase.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.2",
    "supabase": "^2.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.2",
    "@supabase/ssr": "^0.5.2",
    "@careflow/shared": "workspace:*"
  }
}
